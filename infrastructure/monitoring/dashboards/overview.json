{
  "title": "Vue d'ensemble - Plateforme (Santé, Débit, Latence, Erreurs)",
  "description": "Dashboard synthétique d'observabilité : débit, latence p50/p95/p99 et erreurs par service et runner (Ticket 4.1).",
  "layout_type": "ordered",
  "template_variables": [
    {
      "name": "service",
      "prefix": "service",
      "default": "*"
    }
  ],
  "widgets": [
    {
      "definition": {
        "title": "Indicateurs Clés de Santé (Vue Globale)",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Débit HTTP Global (req/s)",
              "type": "query_value",
              "requests": [
                {
                  "q": "sum:trace.http.server.request.hits{$service}.as_rate()",
                  "aggregator": "sum"
                }
              ],
              "precision": 2
            }
          },
          {
            "definition": {
              "title": "Débit gRPC Inter-services (req/s)",
              "type": "query_value",
              "requests": [
                {
                  "q": "sum:trace.grpc.server.request.hits{$service}.as_rate()",
                  "aggregator": "sum"
                }
              ],
              "precision": 2
            }
          },
          {
            "definition": {
              "title": "Latence HTTP p50 (Médiane)",
              "type": "query_value",
              "requests": [
                {
                  "q": "p50:trace.http.server.request{$service}",
                  "aggregator": "avg"
                }
              ],
              "custom_unit": "s",
              "precision": 3
            }
          },
          {
            "definition": {
              "title": "Latence HTTP p95 (Critique)",
              "type": "query_value",
              "requests": [
                {
                  "q": "p95:trace.http.server.request{$service}",
                  "aggregator": "avg"
                }
              ],
              "custom_unit": "s",
              "precision": 3
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Trafic & Débit par Service",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Débit HTTP par service (req/s)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:trace.http.server.request.hits{$service} by {service}.as_rate()",
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Débit gRPC par service (req/s)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:trace.grpc.server.request.hits{$service} by {service}.as_rate()",
                  "display_type": "line",
                  "style": {
                    "palette": "purple",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Top Services les plus sollicités (Requêtes HTTP)",
              "type": "toplist",
              "requests": [
                {
                  "q": "top(sum:trace.http.server.request.hits{$service} by {service}.as_count(), 10, 'sum', 'desc')"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Latence & Performance (p50, p95, p99)",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Latence HTTP (p50 vs p95)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "p50:trace.http.server.request{$service}",
                  "display_type": "line",
                  "style": {
                    "palette": "cool",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                },
                {
                  "q": "p95:trace.http.server.request{$service}",
                  "display_type": "line",
                  "style": {
                    "palette": "orange",
                    "line_type": "dashed",
                    "line_width": "thick"
                  }
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Latence gRPC inter-services (p50 vs p95)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "p50:trace.grpc.server{$service}",
                  "display_type": "line",
                  "style": {
                    "palette": "purple",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                },
                {
                  "q": "p95:trace.grpc.server{$service}",
                  "display_type": "line",
                  "style": {
                    "palette": "red",
                    "line_type": "dashed",
                    "line_width": "thick"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Erreurs & Résilience",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Erreurs HTTP par service",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:trace.http.server.request.errors{$service} by {service}.as_count()",
                  "display_type": "bars",
                  "style": {
                    "palette": "red"
                  }
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Erreurs gRPC par service",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:trace.grpc.server.request.errors{$service} by {service}.as_count()",
                  "display_type": "bars",
                  "style": {
                    "palette": "orange"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
