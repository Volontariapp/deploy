{
  "title": "Vue d'ensemble - Plateforme (Santé, Débit, Latence, Erreurs)",
  "description": "Dashboard synthétique d'observabilité : débit, latence p50/p95/p99 et taux d'erreur par service et runner (Ticket 4.1).",
  "layout_type": "ordered",
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "default": "*"
    },
    {
      "name": "service",
      "prefix": "service",
      "default": "*"
    }
  ],
  "widgets": [
    {
      "definition": {
        "title": "Indicateurs Clés de Santé (Vue Globale)",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Débit Total (Transactions / sec)",
              "type": "query_value",
              "requests": [
                {
                  "q": "sum:trace.*.request.hits{$env, $service}.as_rate()",
                  "aggregator": "sum"
                }
              ],
              "precision": 2
            }
          },
          {
            "definition": {
              "title": "Latence Médiane (p50)",
              "type": "query_value",
              "requests": [
                {
                  "q": "p50:trace.*.request{$env, $service}",
                  "aggregator": "avg"
                }
              ],
              "custom_unit": "s",
              "precision": 3
            }
          },
          {
            "definition": {
              "title": "Latence Critique (p95)",
              "type": "query_value",
              "requests": [
                {
                  "q": "p95:trace.*.request{$env, $service}",
                  "aggregator": "avg"
                }
              ],
              "custom_unit": "s",
              "precision": 3
            }
          },
          {
            "definition": {
              "title": "Taux d'Erreur Moyen (%)",
              "type": "query_value",
              "requests": [
                {
                  "q": "(sum:trace.*.request.errors{$env, $service}.as_count() / sum:trace.*.request.hits{$env, $service}.as_count()) * 100",
                  "aggregator": "avg"
                }
              ],
              "custom_unit": "%",
              "precision": 2
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Trafic & Débit par Service",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Débit de requêtes par service (hits/s)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:trace.*.request.hits{$env, $service} by {service}.as_rate()",
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Top 10 Services les plus sollicités (Requêtes totales)",
              "type": "toplist",
              "requests": [
                {
                  "q": "top(sum:trace.*.request.hits{$env, $service} by {service}.as_count(), 10, 'sum', 'desc')"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Latence & Performance (p50, p95, p99)",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Latence p50 (Médiane) par service",
              "type": "timeseries",
              "requests": [
                {
                  "q": "p50:trace.*.request{$env, $service} by {service}",
                  "display_type": "line",
                  "style": {
                    "palette": "warm",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Latence p95 & p99 (Pire cas)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "p95:trace.*.request{$env, $service}",
                  "display_type": "line",
                  "style": {
                    "palette": "orange",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                },
                {
                  "q": "p99:trace.*.request{$env, $service}",
                  "display_type": "line",
                  "style": {
                    "palette": "red",
                    "line_type": "dashed",
                    "line_width": "thick"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Erreurs & Résilience",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Taux d'erreur global (%)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "(sum:trace.*.request.errors{$env, $service}.as_count() / sum:trace.*.request.hits{$env, $service}.as_count()) * 100",
                  "display_type": "bars",
                  "style": {
                    "palette": "red"
                  }
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Nombre d'erreurs par service",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:trace.*.request.errors{$env, $service} by {service}.as_count()",
                  "display_type": "line",
                  "style": {
                    "palette": "cool",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Activité des Runners (Workers, Outbox & Post-processors)",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Événements traités par les Runners (outbox-*, worker-*, post-processor-*)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:trace.*.request.hits{service:*-runner* OR service:worker-* OR service:post-processor-* OR service:outbox-*, $env} by {service}.as_rate()",
                  "display_type": "line",
                  "style": {
                    "palette": "purple",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Erreurs sur les Runners",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:trace.*.request.errors{service:*-runner* OR service:worker-* OR service:post-processor-* OR service:outbox-*, $env} by {service}.as_count()",
                  "display_type": "bars",
                  "style": {
                    "palette": "warm"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
